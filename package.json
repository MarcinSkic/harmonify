{
  "name": "harmonify",
  "type": "module",
  "version": "3.2.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --port 37449",
    "dev:api": "vercel -A vercel.local.json dev --listen 37449",
    "build": "vue-tsc --build --force && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "UID=$(id -u) GID=$(id -g) docker compose -f docker-compose.e2e.yml run --rm e2e",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force && tsc -p api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@lucide/vue": "^1.72.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/file-saver": "^2.0.7",
    "@vueuse/core": "^14.4.0",
    "audiomotion-analyzer": "^4.5.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color-convert": "^3.1.3",
    "dexie": "^4.4.7",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "js-md5": "^0.9.2",
    "papaparse": "^5.7.1",
    "pinia": "^3.0.4",
    "query-string": "^9.5.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "universal-cookie": "^8.1.2",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-format": "^2.0.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vercel": "^11.2.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
